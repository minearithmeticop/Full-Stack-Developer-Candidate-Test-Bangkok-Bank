// Prisma Schema for SQLite (Local Development & E2E Testing)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Collection {
  id          String     @id @default(uuid())
  name        String
  description String?
  ownerId     String
  bookmarks   Bookmark[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId])
}

model Bookmark {
  id           String      @id @default(uuid())
  url          String
  title        String
  notes        String?
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  ownerId      String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([ownerId])
  @@index([collectionId])
}
